APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=expense_tracker
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=minio
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MINIO_ACCESS_KEY=sail
MINIO_SECRET_KEY=password
MINIO_REGION=us-east-1
MINIO_BUCKET=expense-tracker
MINIO_ENDPOINT=http://minio:9000
MINIO_USE_PATH_STYLE_ENDPOINT=true

RECEIPT_FILESYSTEM_DISK=minio
RECEIPT_MAX_UPLOAD_BYTES=15728640
RECEIPT_MAX_PIXELS=24000000
RECEIPT_ABANDONED_RETENTION_DAYS=30
PADDLE_OCR_URL=http://ocr:8000
PADDLE_OCR_CONNECT_TIMEOUT=5
PADDLE_OCR_TIMEOUT=45
PADDLE_OCR_PROVIDER_VERSION=paddleocr-3.7.0
PADDLE_OCR_MODEL_VERSION=PP-OCRv6

REDIS_QUEUE_RETRY_AFTER=120
SANCTUM_EXPIRATION=43200

VITE_APP_NAME="${APP_NAME}"

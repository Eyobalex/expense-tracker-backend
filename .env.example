APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
API_VERSION=1.0.0
# Keep generated OpenAPI documentation private outside local development.
API_DOCS_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=expense_tracker
DB_USERNAME=sail
DB_PASSWORD=password
DB_TIMEZONE=UTC
SYNC_CURSOR_RETENTION_DAYS=30
SYNC_TOMBSTONE_RETENTION_DAYS=30
SYNC_PAGE_SIZE=100
SYNC_MAXIMUM_PAGE_SIZE=250

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=minio
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MINIO_ACCESS_KEY=sail
MINIO_SECRET_KEY=password
MINIO_REGION=us-east-1
MINIO_BUCKET=expense-tracker
MINIO_ENDPOINT=http://minio:9000
MINIO_USE_PATH_STYLE_ENDPOINT=true

RECEIPT_FILESYSTEM_DISK=minio
RECEIPT_MAX_UPLOAD_BYTES=15728640
RECEIPT_MAX_PIXELS=24000000
RECEIPT_ABANDONED_RETENTION_DAYS=30
PADDLE_OCR_URL=http://ocr:8000
PADDLE_OCR_CONNECT_TIMEOUT=5
PADDLE_OCR_TIMEOUT=45
PADDLE_OCR_PROVIDER_VERSION=paddleocr-3.7.0
PADDLE_OCR_MODEL_VERSION=PP-OCRv6

REDIS_QUEUE_RETRY_AFTER=120
SANCTUM_EXPIRATION=43200

VITE_APP_NAME="${APP_NAME}"

OPEN_EXCHANGE_RATES_APP_ID="OER-APP-ID-HERE"
OPEN_EXCHANGE_RATES_URL="https://openexchangerates.org/api"
OPEN_EXCHANGE_RATES_MONTHLY_QUOTA=1000
OPEN_EXCHANGE_RATES_CONNECT_TIMEOUT=5
OPEN_EXCHANGE_RATES_TIMEOUT=15

# Firebase Cloud Messaging HTTP v1. Mount the service-account JSON outside the
# repository on the VPS; never commit the credential file or an access token.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_CREDENTIALS=
FCM_ACCESS_TOKEN=
FCM_CONNECT_TIMEOUT_SECONDS=3
FCM_TIMEOUT_SECONDS=10

# Generated reports and account-export artifacts are private MinIO objects.
# Configure explicit production retention values before release; these local defaults are not approved production policy.
REPORTS_DISK=minio
REPORT_RETENTION_DAYS=7
FULL_ACCOUNT_EXPORT_RETENTION_DAYS=3
REPORTS_ALLOW_SYNCHRONOUS_CSV=true
REPORTS_SYNCHRONOUS_CSV_ROW_LIMIT=10000
REPORTS_RATE_LIMIT_PER_MINUTE=10

# PRODUCT/OPERATIONS DECISION REQUIRED BEFORE PRODUCTION. Set every value after
# approving the retention policy, recovery objectives, and successful restore drill.
RELEASE_RETENTION_POLICY_APPROVED=false
RELEASE_RECOVERY_OBJECTIVES_APPROVED=false
RELEASE_BACKUP_RESTORE_DRILL_COMPLETED=false
FAILED_OCR_ARTIFACT_RETENTION_DAYS=
PROCESSING_DERIVATIVE_RETENTION_DAYS=
AUDIT_EVENT_RETENTION_DAYS=
DELETED_ACCOUNT_GRACE_PERIOD_DAYS=
POSTGRESQL_BACKUP_RETENTION_DAYS=
MINIO_BACKUP_RETENTION_DAYS=
FAILED_JOB_RETENTION_DAYS=
RPO_POSTGRESQL_MINUTES=
RPO_MINIO_RECEIPTS_MINUTES=
RPO_REPORT_EXPORT_ARTIFACTS_MINUTES=
RTO_CORE_API_DATABASE_MINUTES=
RTO_RECEIPT_STORAGE_MINUTES=
RTO_QUEUE_OCR_MINUTES=

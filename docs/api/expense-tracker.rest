# Next-Gen Financial Tracker API scenarios
#
# Run with VS Code REST Client (humao.rest-client) or a compatible client.
# Replace every placeholder after each create response. Successful responses use
# { data, meta, links }; failures use { error: { code, message, fields,
# request_id } }. Every mutation uses a fresh Idempotency-Key; requests that
# change a versioned resource also require its current If-Match value.

@baseUrl = http://localhost:8000/api/v1
@email = eyob@example.test
@password = 12345678
@token = replace-with-login-data-token
@deviceId = 11111111-1111-4111-8111-111111111111
@accountId = replace-with-account-uuid
@categoryId = replace-with-category-uuid
@targetCategoryId = replace-with-second-category-uuid
@merchantId = replace-with-merchant-uuid
@targetMerchantId = replace-with-target-merchant-uuid
@itemId = replace-with-item-uuid
@targetItemId = replace-with-target-item-uuid
@transactionId = replace-with-transaction-uuid
@receiptId = replace-with-receipt-uuid
@deviceRecordId = replace-with-device-record-uuid
@candidateId = replace-with-normalization-candidate-uuid
@duplicateCandidateId = replace-with-duplicate-candidate-uuid
@receiptPath = ./fixtures/receipt.jpg

### Register
POST {{baseUrl}}/auth/register
Accept: application/json
Content-Type: application/json
Idempotency-Key: {{$guid}}

{"name":"Eyob","email":"{{email}}","password":"{{password}}","password_confirmation":"{{password}}","client_device_id":"{{deviceId}}","platform":"android","app_version":"0.1.0"}

### Login — copy data.token into @token
# @name login
POST {{baseUrl}}/auth/login
Accept: application/json
Content-Type: application/json
Idempotency-Key: {{$guid}}

{"email":"{{email}}","password":"{{password}}","client_device_id":"{{deviceId}}","platform":"android","app_version":"0.1.0"}

### Password reset request
POST {{baseUrl}}/auth/forgot-password
Accept: application/json
Content-Type: application/json
Idempotency-Key: {{$guid}}

{"email":"{{email}}"}

